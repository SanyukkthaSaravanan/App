# --- Flaire frontend environment ---
# Copy to .env for local dev. In production (Vercel), set these in the
# project's Environment Variables settings.

# Backend API base URL.
#   local dev:   http://localhost:4000
#   production:  your Render backend URL, e.g. https://flaire-api.onrender.com
VITE_API_URL="http://localhost:4000"

# Force-enable the desktop live camera scanner in a production build.
# Leave unset for cloud deploys (the server has no camera). It is always on
# in local `npm run dev`.
# VITE_ENABLE_LIVE_SCAN="true"

# --- PostHog analytics ---
# Your project's PUBLIC api key (Project Settings → API keys, starts with
# "phc_"). Safe to expose in the client. If unset, analytics stays off.
# VITE_POSTHOG_KEY="phc_xxx"
# Ingestion host — US: https://us.i.posthog.com  EU: https://eu.i.posthog.com
# VITE_POSTHOG_HOST="https://us.i.posthog.com"
