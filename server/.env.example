# --- Flaire backend environment ---

# SQLite file path (relative to the server/ directory)
DATABASE_URL="file:./flaire.db"

# JWT signing secret — change this for any non-demo deployment
JWT_SECRET="flaire-dev-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# HTTP port
PORT=4000

# Comma-separated allowed origins for CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
