# --- Flaire backend environment ---
# Copy to server/.env for local dev. In production (Render), set these in the
# dashboard — never commit real secrets.

# ── Supabase (database) ────────────────────────────────────────
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, NEVER in the frontend

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── HTTP ───────────────────────────────────────────────────────
# Local dev only. Render/Railway inject PORT automatically.
PORT=4000

# Comma-separated allowed CORS origins. In prod set to your Vercel URL,
# e.g. https://flaire.vercel.app
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ── AI services (optional) ─────────────────────────────────────
# Enables Whisper speech-to-text; without it, STT falls back to the browser.
OPENAI_API_KEY=""

# ── Live medication scanner (LOCAL DESKTOP ONLY) ───────────────
# These only apply when running the backend on a machine with a camera.
# They are irrelevant in the cloud (Render/Vercel have no camera).
OCR_DIR="C:\\Users\\sanyu\\OneDrive\\Desktop\\Flaire\\OCR"
PYTHON_BIN="python"
OCR_CAMERA="2"
