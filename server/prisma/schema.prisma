// =============================================================
//  Flaire – database schema
//  Provider: SQLite (single file, no external service needed)
//  ORM:      Prisma
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Account / profile ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profile / medical context
  conditions   String?  // JSON array of diagnosis strings
  allergies    String?  // JSON array
  avatarUrl    String?

  // Relations
  symptoms        Symptom[]
  medications     Medication[]
  doseLogs        MedicationDose[]
  checkIns        DailyCheckIn[]
  dietLogs        DietLog[]
  flares          FlareEvent[]
  medicalRecords  MedicalRecord[]
  posts           CommunityPost[]
  comments        CommunityComment[]
  insights        Insight[]
  calendarEvents  CalendarEvent[]
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Symptom tracking (body map + general) ----------

model Symptom {
  id          String   @id @default(cuid())
  userId      String
  // bodyPart is null for general / non-localized entries (e.g. fatigue)
  bodyPart    String?
  bodyPartName String?
  // Either a single symptom name (for general) or multiple tags (for body-map)
  symptoms    String    // JSON array of strings: e.g. ["Pain","Swelling"]
  severity    Int       // 1..10
  notes       String?
  view        String?   // 'front' | 'side' | null
  loggedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([userId, bodyPart])
}

// ---------- Medications ----------

model Medication {
  id           String   @id @default(cuid())
  userId       String
  name         String
  dosage       String   // e.g. "200mg"
  frequency    String   // e.g. "Twice daily"
  timesPerDay  Int      @default(1)
  scheduleTimes String  // JSON array of HH:mm strings
  startDate    DateTime
  endDate      DateTime?
  color        String   @default("#7293BB")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  doses MedicationDose[]

  @@index([userId, active])
}

model MedicationDose {
  id            String    @id @default(cuid())
  userId        String
  medicationId  String
  scheduledAt   DateTime
  takenAt       DateTime?
  skipped       Boolean   @default(false)
  notes         String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([medicationId, scheduledAt])
}

// ---------- Daily check-in ----------

model DailyCheckIn {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime // date only — the day this check-in represents
  energy          Int?     // 1..10
  painIntensity   String?  // 'mild' | 'moderate' | 'severe'
  painLocations   String?  // JSON array
  painTypes       String?  // JSON array
  flareStatus     String?  // 'no' | 'maybe' | 'yes'
  flareSeverity   String?  // 'mild' | 'moderate' | 'severe'
  sleep           String?  // 'poor' | 'okay' | 'good'
  sleepHours      Float?
  sleepDisrupted  Boolean  @default(false)
  stress          Int?     // 1..10
  mood            Int?     // 1..10
  medsTaken       String?  // 'yes' | 'some' | 'no'
  sideEffects     String?  // JSON array
  gutIssues       String?  // JSON array
  foodTriggers    String?  // JSON array
  mobility        String?  // 'hard' | 'some-difficulty' | 'okay'
  notes           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------- Diet tracker ----------

model DietLog {
  id         String   @id @default(cuid())
  userId     String
  mealType   String   // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  foods      String   // JSON array of food names
  triggers   String?  // JSON array of suspected trigger foods
  calories   Int?
  notes      String?
  ateAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ateAt])
}

// ---------- Flare events ----------

model FlareEvent {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime
  endedAt    DateTime?
  severity   Int       // 1..10
  triggers   String?   // JSON array
  locations  String?   // JSON array of body parts affected
  notes      String?
  resolved   Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ---------- Medical records ----------

model MedicalRecord {
  id           String   @id @default(cuid())
  userId       String
  title        String
  type         String   // 'lab' | 'imaging' | 'visit' | 'prescription' | 'other'
  providerName String?
  date         DateTime
  fileUrl      String?  // stored file (or external link)
  notes        String?
  tags         String?  // JSON array
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ---------- Community ----------

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  content   String
  tags      String?  // JSON array
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityComment[]

  @@index([createdAt])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ---------- Insights (computed patterns) ----------

model Insight {
  id          String   @id @default(cuid())
  userId      String
  type        String   // 'trigger' | 'pattern' | 'trend' | 'correlation'
  title       String
  description String
  data        String?  // JSON payload for chart data
  severity    String   @default("info") // 'info' | 'warning' | 'positive'
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Calendar (aggregated event feed) ----------

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  type            String   // 'symptom' | 'medication' | 'checkin' | 'flare' | 'appointment'
  title           String
  date            DateTime
  endDate         DateTime?
  relatedEntityId String?
  payload         String?  // JSON for extra detail

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
